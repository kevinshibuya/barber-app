# Copy to ~/apps/barber-worker/.env on the box (mode 600) and fill in. The only
# place a secret lives; bin/ship.sh never copies a .env.
# Written by bin/deploy.sh.
IMAGE_TAG=
PREVIOUS_IMAGE_TAG=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Bills per render (see CLAUDE.md): about $0.63 a visit on nano-banana-2.1.
IMAGE_PROVIDER=nano-banana-2.1
GEMINI_API_KEY=
FAL_KEY=
# A visit's link is <base>/v/<share token>.
CLIENT_PAGE_BASE_URL=https://barber.kevinshibuya.com
PREVIEW_CONCURRENCY=6
PREVIEW_STALE_TIMEOUT_SECONDS=300
