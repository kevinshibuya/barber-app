{
  "name": "@barber/worker",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "pnpm --filter @barber/shared run build && nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "smoke:client-page": "jest --testRegex '\\.smoke\\.ts$' test/smoke/client-page.smoke.ts"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@nestjs/cli": "^12.0.10",
    "@nestjs/schematics": "^12.0.10",
    "@nestjs/testing": "^12.2.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "babel-jest": "^30.5.2",
    "babel-plugin-transform-import-meta": "^2.3.3",
    "eslint": "^9.39.0",
    "jest": "^30.5.2",
    "playwright-core": "1.63.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "dependencies": {
    "@barber/shared": "workspace:*",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@supabase/supabase-js": "^2.118.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5"
  }
}
