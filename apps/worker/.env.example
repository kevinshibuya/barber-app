# Copy to .env and fill in. `scripts/db-test.sh` prints the local values.
PORT=3000
SUPABASE_URL=http://127.0.0.1:56321
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:56322/postgres
# Image provider: gemini, nano-banana-2.1, flux, flux-klein, seedream or fake.
# The gemini ones run on GEMINI_API_KEY, the flux ones and seedream on fal.ai;
# fake answers with a fixed image, for local runs.
# Local runs stay on fake: the others bill per render (see CLAUDE.md).
IMAGE_PROVIDER=fake
GEMINI_API_KEY=
FAL_KEY=
# Base URL of the client page; a visit's link is <base>/v/<share token>.
CLIENT_PAGE_BASE_URL=http://127.0.0.1:3000
# Parallel provider calls.
PREVIEW_CONCURRENCY=6
# A running preview claimed longer ago than this is taken back into the queue.
PREVIEW_STALE_TIMEOUT_SECONDS=300
