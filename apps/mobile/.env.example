# Copy to .env and fill in. `scripts/db-test.sh` prints the local values.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:56321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Base URL of the client page served by the worker; a visit's link is <base>/v/<share token>.
EXPO_PUBLIC_CLIENT_PAGE_BASE_URL=http://127.0.0.1:3000
