{
  "expo": {
    "name": "Barber",
    "slug": "barber",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "barber",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "bundleIdentifier": "com.kevinshibuya.barber",
      "supportsTablet": false
    },
    "android": {
      "package": "com.kevinshibuya.barber",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "cameraPermission": "O Barber usa a câmera para fotografar o cliente e gerar as prévias de corte.",
          "photosPermission": "O Barber usa suas fotos para escolher uma foto do cliente e gerar as prévias de corte.",
          "microphonePermission": false
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "c7dbe639-a270-412f-a738-f69962ec31ad"
      }
    },
    "owner": "kevinshibuya"
  }
}
